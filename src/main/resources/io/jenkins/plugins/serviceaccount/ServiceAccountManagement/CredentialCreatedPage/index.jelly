<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:l="/lib/layout">
    <l:layout title="Credential created">
        <l:main-panel>
            <h1>Credential created</h1>
            <p>Copy and store this secret now. It cannot be viewed again.</p>
            <p class="jenkins-form-item">Username: <code>${it.username}</code></p>
            <p class="jenkins-form-item">Secret: <code id="service-account-secret">${it.secret}</code></p>
            <p class="jenkins-form-item"><a href="./${it.accountId}/">Return to service account</a></p>
        </l:main-panel>
    </l:layout>
</j:jelly>
