<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">
    <f:section title="Service-account credential policy">
        <f:entry title="Default credential lifetime (days)" field="defaultCredentialLifetimeDays">
            <f:number />
        </f:entry>
        <f:entry title="Maximum credential lifetime (days)" field="maximumCredentialLifetimeDays">
            <f:number />
        </f:entry>
        <f:entry title="Allow non-expiring credentials" field="allowNonExpiringCredentials">
            <f:checkbox />
        </f:entry>
    </f:section>
</j:jelly>
